# Переменные нужны только для запуска интерфейса в обычном браузере (npm run dev:web).
# Внутри Cursor адрес, режим демо и модели задаются в настройках расширения (decomposer.*),
# а токен доступа хранится в SecretStorage (команда «Декомпозитор: задать токен доступа»).
#
# Ключей LLM здесь нет и быть не должно: ключ хранится только на сервере (backend).

# Адрес backend (POST /v1/plans)
VITE_API_BASE_URL=http://localhost:8787

# true — ответы из встроенных демо-сценариев, backend не нужен
VITE_DEMO_MODE=true

# Таймаут запроса к backend, секунд
VITE_REQUEST_TIMEOUT_SEC=100
